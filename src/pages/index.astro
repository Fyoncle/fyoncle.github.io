---
import Divider from "../components/Divider.astro";

const name = "Fyoncle";
const avatar = "/profile_picture.png";

const artstation = [
  {
    name: "ArtStation | Portfolio",
    url: "https://www.artstation.com/fyoncle",
    image: "https://cdna.artstation.com/p/assets/images/images/086/075/808/large/fyoncle-result.jpg?1742328287",
    icon: "/icons/artstation.png",
  },
];

const socials = [
  { name: "YouTube", url: "https://www.youtube.com/channel/UCC6CXY5bAmv4CisBWoYDo4w", icon: "/icons/youtube.png" },
  { name: "Bluesky", url: "https://bsky.app/profile/fyoncle.bsky.social", icon: "/icons/bluesky.png" },
  { name: "GitHub", url: "https://github.com/fyoncle", icon: "/icons/github.png" },
  { name: "Modrinth", url: "https://modrinth.com/user/fyoncle", icon: "/icons/modrinth.png" },
  { name: "CurseForge", url: "https://www.curseforge.com/members/fyoncle", icon: "/icons/curseforge.png" },
];

const links = [
  { name: "Elysium Days | The Best Minecraft Modpack", url: "https://modrinth.com/modpack/elysium-days", icon: "/icons/elysiumdays.png" },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{name}</title>

    <meta name="description" content="3D Artist and modpack developer from Türkiye." />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Fyoncle" />
    <meta property="og:description" content="3D Artist and modpack developer from Türkiye." />
    <meta property="og:image" content="https://fyoncle.vercel.app/embed.png" />
    <meta property="og:url" content="https://fyoncle.vercel.app/" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#c6a0f6" />
  </head>

  <body>
    <canvas class="rain" aria-hidden="true"></canvas>

    <main class="square">
      <img
        class="avatar"
        src={avatar}
        alt={`${name} profile picture`}
      />

      <h1>{name}</h1>
      <p class="pronounce">he/him | /fay-on-KIL/</p>

      <p class="description">
        Hi there human! I'm a passionate 3D Artist and a modpack developer
        from Türkiye!
      </p>

      <div class="socials">
        {socials.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon"
            aria-label={s.name}
            title={s.name}
          >
            <span style={`--icon: url("${s.icon}")`}></span>
          </a>
        ))}
      </div>

      <nav class="links">

        {artstation.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class="artstation-link"
          >
            <div class="artstation-image">
              <img src={l.image} alt={l.name} />
            </div>

            <span class="artstation-label">
              <img class="link-icon" src={l.icon} alt="" width="32" height="32" />
              {l.name}
            </span>
          </a>
        ))}

        <Divider />

        {links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link-button"
          >
            <img class="link-icon" src={l.icon} alt="" width="32" height="32" />
            {l.name}
          </a>
        ))}

        <p class="extra">
          If you want to know more about me,<br />
          I <strong>love</strong> rain,<br />
          my <strong>favorite</strong> color is purple,<br />
          and I can't stop listening to <a href="https://www.youtube.com/@CitizenSoldier/videos" target="_blank" rel="noopener noreferrer">Citizen Soldier</a>!!
        </p>

      </nav>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --base: #24273a;
    --mantle: #1e2030;
    --crust: #181926;
    --surface0: #363a4f;
    --surface1: #494d64;
    --text: #cad3f5;
    --subtext: #a5adcb;
    --mauve: #c6a0f6;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html,
  body {
    min-height: 100%;
  }

  body {
    display: grid;
    place-items: center;

    min-height: 100vh;
    min-height: 100dvh;

    padding: 2rem;
    padding-top: max(4.5rem, env(safe-area-inset-top) + 2rem);
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    padding-left: max(2rem, env(safe-area-inset-left));
    padding-right: max(2rem, env(safe-area-inset-right));

    background: var(--crust);
    color: var(--text);
    font-family: system-ui, sans-serif;
  }

  .rain {
    position: fixed;
    inset: 0;
    display: block;

    width: 100%;
    height: 100%;

    z-index: 0;
    opacity: 0.3;
    pointer-events: none;
  }
</style>

<style>
  .square {
    position: relative;
    z-index: 1;

    width: min(90vw, 600px);
    min-height: auto;

    padding: 4.5rem 2rem 2rem;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;

    background: var(--base);
    border: 2px solid var(--surface1);
    border-radius: 24px;
  }

  .avatar {
    position: absolute;

    top: 0;
    left: 50%;

    transform: translate(-50%, -50%);

    width: 120px;
    height: 120px;

    border-radius: 50%;
    object-fit: cover;

    background: var(--surface0);
    border: 4px solid var(--mauve);
  }

  h1 {
    font-size: 1.75rem;
    color: var(--mauve);
  }

  .pronounce {
    margin-top: -0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--subtext);
    opacity: 0.5;
  }

  .description {
    margin-inline: auto;
    max-width: 450px;

    text-align: center;
    line-height: 1.5;

    color: var(--subtext);
  }

  .extra {
    margin-inline: auto;
    max-width: 100%;

    text-align: center;
    line-height: 1.5;

    color: var(--subtext);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
  }

  .social-icon {
    display: grid;
    place-items: center;

    width: 44px;
    height: 44px;

    border-radius: 8px;
  }

  .social-icon span {
    width: 28px;
    height: 28px;

    background: #ffffff;

    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;

    transition: background 0.15s;
  }

  .social-icon:hover span,
  .social-icon:focus-visible span {
    background: var(--mauve);
  }

  .social-icon:focus-visible {
    outline: 2px solid var(--mauve);
    outline-offset: 2px;
  }

  .links {
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    margin-top: 0.5rem;
  }

  .extra a {
    color: var(--mauve);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .extra a:hover,
  .extra a:focus-visible {
    color: var(--text);
  }

  .artstation-link {
    width: 100%;

    display: flex;
    flex-direction: column;

    padding: 0;

    overflow: hidden;

    color: var(--text);
    text-decoration: none;

    background: var(--surface0);

    border: 2px solid var(--surface1);
    border-radius: 12px;

    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s,
      transform 0.15s;
  }

  .artstation-image {
    width: 100%;
    height: 200px;

    overflow: hidden;
  }

  .artstation-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition: transform 0.25s;
  }

  .artstation-label {
    width: 100%;

    padding: 0.75rem 1rem;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;

    text-align: center;
    font-weight: 500;
  }

  .artstation-link:hover,
  .artstation-link:focus-visible {
    background: var(--mauve);
    border-color: var(--mauve);
    color: var(--crust);

    transform: translateY(-2px);
  }

  .artstation-link:hover .artstation-image img,
  .artstation-link:focus-visible .artstation-image img {
    transform: scale(1.01);
  }

  .link-button {
    width: 100%;

    padding: 0.75rem 1rem;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;

    text-align: center;
    text-decoration: none;

    color: var(--text);
    background: var(--surface0);

    border: 2px solid var(--surface1);
    border-radius: 12px;

    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s,
      transform 0.15s;
  }

  .link-icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
  }

  .link-button:hover,
  .link-button:focus-visible {
    background: var(--mauve);
    border-color: var(--mauve);
    color: var(--crust);

    transform: translateY(-2px);
  }
</style>

<script>
  const canvas = document.querySelector(".rain") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  const chars = "|/\\:.'!;,";
  const size = 16;
  const trail = 12;

  function render() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    ctx.fillStyle = "#181926";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.font = `${size}px monospace`;
    ctx.textBaseline = "top";

    const cols = Math.ceil(canvas.width / size);
    const rows = Math.ceil(canvas.height / size);

    for (let c = 0; c < cols; c++) {
      if (Math.random() < 0.35) continue;
      const head = Math.floor(Math.random() * rows);

      for (let t = 0; t < trail; t++) {
        const row = head - t;
        if (row < 0) break;
        const ch = chars[Math.floor(Math.random() * chars.length)];
        ctx.globalAlpha = 1 - t / trail;
        ctx.fillStyle = "#c6a0f6";
        ctx.fillText(ch, c * size, row * size);
      }
    }
    ctx.globalAlpha = 1;
  }

  render();

  let resizeTimer: number | undefined;
  window.addEventListener("resize", () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(render, 150);
  });

  const heartLink = document.querySelector(".extra a") as HTMLElement | null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function spawnHeart() {
    if (!heartLink) return;
    const r = heartLink.getBoundingClientRect();
    const heart = document.createElement("span");
    heart.textContent = "♥";
    heart.setAttribute("aria-hidden", "true");
    heart.style.cssText = `position:fixed;left:${r.left + Math.random() * r.width}px;top:${r.top}px;color:#c6a0f6;font-size:${10 + Math.random() * 10}px;pointer-events:none;z-index:10;`;
    document.body.appendChild(heart);

    const drift = (Math.random() - 0.5) * 40;
    heart.animate(
      [
        { transform: "translate(0, 0)", opacity: 1 },
        { transform: `translate(${drift}px, -60px)`, opacity: 0 },
      ],
      { duration: 1000, easing: "ease-out" }
    ).onfinish = () => heart.remove();
  }

  let heartTimer: number | undefined;

  function startHearts() {
    if (reduceMotion.matches || heartTimer) return;
    spawnHeart();
    heartTimer = window.setInterval(spawnHeart, 150);
  }

  function stopHearts() {
    window.clearInterval(heartTimer);
    heartTimer = undefined;
  }

  heartLink?.addEventListener("mouseenter", startHearts);
  heartLink?.addEventListener("mouseleave", stopHearts);
  heartLink?.addEventListener("focus", startHearts);
  heartLink?.addEventListener("blur", stopHearts);
</script>